{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noUnusedLocals": true
  },
  "include": ["src", "server", "vite.config.ts", "../src/engine", "../src/videos", "../src/fonts.ts", "../src/schema.ts", "../src/components"]
}
